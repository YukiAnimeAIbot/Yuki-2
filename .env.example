# Core identity
OWNER_NUMBER=
OWNER_DISPLAY_NAME=Owner

# Supabase (service role key is a secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REQUIRED=true # Required; false is unsupported

# Keep this 32-byte key stable across deploys; generate with crypto.randomBytes(32).
AUTH_SNAPSHOT_ENCRYPTION_KEY=

# Groq AI
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_REQUEST_TIMEOUT_MS=25000
GROQ_MAX_IMAGE_BYTES=8388608

# Private Telegram pairing: only IDs listed here can pair/manage the bridge.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# PUBLIC_PAIRING is ignored; pairing is always admin-restricted.

# Optional full web search (Tavily primary; Brave secondary)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# MEGA menu media storage
MEGA_EMAIL=
MEGA_PASSWORD=

# Optional monitoring
UPTIME_MONITOR_URL=
UPTIME_MONITOR_INTERVAL_MS=300000

# Protected Yuki Account Center (generate a random 32+ character secret)
YUKI_WEB_ADMIN_TOKEN=
